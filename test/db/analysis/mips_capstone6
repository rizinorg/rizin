NAME=mips32 jr ra as ret
FILE=malloc://32
ARGS=-a mips -b 32
CMDS=<<EOF
e cfg.bigendian=true
wx 03e00008
aa
ao~type
EOF
EXPECT=<<EOF
type: ret
    - type: "reg"
EOF
RUN

