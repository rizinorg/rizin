NAME=mips32 stack accounting
FILE=malloc://32
ARGS=-a mips -b 32
CMDS=<<EOF
e cfg.bigendian=true
wx 27bdff80
aa
ao~type
ao~stackop
ao~stackptr
EOF
EXPECT=<<EOF
type: add
    - type: "reg"
    - type: "reg"
    - type: "imm"
stackop: inc
stackptr: 128
EOF
RUN

NAME=mips64 stack accounting
FILE=malloc://32
ARGS=-a mips -b 64 -e asm.cpu=mips64
CMDS=<<EOF
e cfg.bigendian=true
wx 67bdff80
aa
ao~type
ao~stackop
ao~stackptr
EOF
EXPECT=<<EOF
type: add
    - type: "reg"
    - type: "reg"
    - type: "imm"
stackop: inc
stackptr: 128
EOF
RUN

NAME=mips32 gp tracking
FILE=malloc://32
ARGS=-a mips -b 32
CMDS=<<EOF
e cfg.bigendian=true
ar gp=0x100000
wx 8f848000 # lw a0, -0x8000(gp)
aa
ao~type
ao~ptr
EOF
EXPECT=<<EOF
type: load
    - type: "reg"
    - type: "mem"
ptr: 0xffffffffffff8000
refptr: 4
EOF
RUN

NAME=mips64 gp tracking
FILE=malloc://32
ARGS=-a mips -b 64 -e asm.cpu=mips64
CMDS=<<EOF
e cfg.bigendian=true
ar gp=0x100000
wx df848000 # ld a0, -0x8000(gp)
aa
ao~type
ao~ptr
EOF
EXPECT=<<EOF
