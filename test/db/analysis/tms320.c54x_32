NAME=c54x analysis: register profile (PC alias resolves)
FILE==
CMDS=<<EOF
e asm.arch=tms320
e analysis.cpu=c54x
arp~^=PC
EOF
EXPECT=<<EOF
=PC	pc
EOF
RUN

