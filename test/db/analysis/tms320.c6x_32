0x00000002      mv    .l1x b5,a9
0x00000004      zero  .l1 a7:a6
0x00000008      ||    extu .s1 a9,24,24,a3
0x0000000c      extu  .s1 a7,0x18,0x18,a5
0x0000000e      cmpeq .l1 a5,a3,a0
0x00000010      [a0]  cmpltu .l1 a6,a8,a1
0x00000014      [!a0] cmpltu .l1 a5,a3,a1
0x00000018      [!a1] bnop .s1 0x6c,0x5
0x0000001c      .fphead n, l, w, bu, nobr, nosat, 0b0001001
EOF

