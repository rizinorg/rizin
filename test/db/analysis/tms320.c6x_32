mv .l1x b3,a2
cmpeq .l1 0x2,a4,a0
.fphead n, l, w, bu, nobr, nosat, 0b1000010
[a0] bnop .s1 sym._C_L11,0x5
mvk .s2 0x17,b4
|| mvk .s1 -0x722f,a4
EOF
RUN


