# A SPKERNEL's stage/cycle field splits by the ii of the SPLOOP that opens its
# loop (SPRUFE8B Table 3-29), read from the image before it, where dis6x takes
# the SPLOOP it listed last. TI-assembled loops of ii 9 and 14, compact and
# 32-bit, the first across a fetch-packet boundary.
NAME=c6x a SPKERNEL splits its stage and cycle by the ii of its SPLOOP
FILE=malloc://0x200
CMDS=<<EOF
e asm.arch=tms320
e analysis.arch=tms320
e asm.cpu=c674x
e analysis.cpu=c674x
e scr.color=0
e asm.bytes=false
wx  @ 0x100
pd 1 @ 0x10c
pd 1 @ 0x126
pd 1 @ 0x150
pd 1 @ 0x174
pd 1 @ 0x180
pd 1 @ 0x1a8
EOF
EXPECT=<<EOF
            0x0000010c      sploop 9
            0x00000126      spkernel 2,7
            0x00000150      sploop 14
            0x00000174      spkernel 1,13
            0x00000180      sploop 14
            0x000001a8      spkernel 3,2
EOF
RUN

# A SPKERNEL closes the loop of the last SPLOOP before it, so one that follows
# another without a SPLOOP between them keeps its field whole, as in dis6x.
NAME=c6x a SPKERNEL without a SPLOOP of its own keeps its stage and cycle field whole
FILE=malloc://64
CMDS=<<EOF
e asm.arch=tms320
e analysis.arch=tms320
e asm.cpu=c674x
e analysis.cpu=c674x
e scr.color=0
e asm.bytes=false
wx 008003040000000000000000000000000040c30f0000000000000000000000000040c30f00000000000000000000000000000000000000000000000000000000
pd 1 @ 0
pd 1 @ 0x10
pd 1 @ 0x20
EOF
EXPECT=<<EOF
            0x00000000      sploop 9
            0x00000010      spkernel 3,15
            0x00000020      spkernel 0x3f
EOF
RUN

# A compact slot is laid out by the header that ends its fetch packet, up to 28
# bytes on. pD, pd with a count, ao and pdb decode from the range, the block or
# the basic block, which can stop short of it: the decoder then read the word
# as a 32-bit opcode, or found a half word undecodable, and a 32-bit branch
# lost the half-word scaling of its packet (#6751).
NAME=c6x compact slots decode the same from a short buffer
FILE=malloc://64
CMDS=<<EOF
e asm.arch=tms320
e cfg.bigendian=false
e asm.cpu=c674x
e scr.color=0
e asm.lines=false
e asm.bytes=false
wx 4602baea2874ca01e805e001740280012ae05002ea05600276220002008020e0
pD 8
b 4
ao 1 @ 0~^size:
ao 1 @ 0~^type:
b 2
pd 1 @ 2
wx 62a38c00f694bc01f4623c0546464e0220a14cd0106f960362818801400000e1 @ 0x20
pD 4 @ 0x30
af+ fcn
afb+ 0 0 4 0x154 4
pdb @ 0
EOF
EXPECT=<<EOF
0x00000000      mv    .l1 a4,a0
0x00000002      [!a0] bnop .s1 0x154,0x5
0x00000004      mvk   .s1 -0x6b18,a3
size: 2
type: mov
0x00000002      [!a0] bnop .s1 0x154,0x5
0x00000030      [!a0] bnop .s1 0xb8,0x5
fcn();
0x00000000      mv    .l1 a4,a0
0x00000002      [!a0] bnop .s1 0x154,0x5
EOF
RUN

# The packet above as big-endian memory holds it: each word keeps its value,
# so the less significant half, now at the higher address, is still the first
# slot (TI cl6x and dis6x), and the second slot of a word is read from before it.
# The packet at 0x20 runs a compact pair in parallel, as its header says. pad
# decodes the packet it is given at 0x20, whose second slots take their halves
# from that hex rather than from the packet already there.
NAME=c6x big-endian compact slots keep the order of their word
FILE=malloc://64
CMDS=<<EOF
e asm.arch=tms320
e cfg.bigendian=true
e asm.cpu=c674x
e scr.color=0
e asm.lines=false
e asm.bytes=false
wx eaba024601ca742801e005e8018002740250e02a026005ea02002276e0208000
pD 8
b 2
pd 1 @ 2
ao 1 @ 2~^size:
ao 1 @ 2~^type:
pD 2 @ 0
b 32
wx 008ca36201bc94f6053c62f4024e4646d04ca12003966f1001888162e1000040 @ 0x20
pd 2 @ 0x2c
s 0x20
pad 24000246440102470c6e0c6e0c6e0c6e000000000000000000000000e1e00000~:0..4
EOF
EXPECT=<<EOF
0x00000000      mv    .l1 a4,a0
0x00000002      [!a0] bnop .s1 0x154,0x5
0x00000004      mvk   .s1 -0x6b18,a3
0x00000002      [!a0] bnop .s1 0x154,0x5
size: 2
type: cjmp
0x00000000      mv    .l1 a4,a0
0x0000002c      mv    .l1 a4,a10
0x0000002e      ||    mv .s1 a4,a0
mv .l1 a4,a0
add .l1 0x1,a0,a0
mv .l2 b4,b0
add .l2 0x2,b0,b0
EOF
RUN

# main() calls c_strlen, decrypt and uart_write_text through compact CALLPs,
# whose displacement counts words: counted in half words, they land inside
# functions.
NAME=c6x compact CALLP reaches its callee in a TI-built ELF
FILE=bins/tms320/emulateme_nostd.ccsv7.c674x.eabi.dbg.elf
CMDS=<<EOF
e scr.color=0
e asm.lines=false
e asm.bytes=false
e asm.comments=false
e asm.flags=false
pd 1 @ 0x8158
pd 1 @ 0x8178
pd 1 @ 0x819a
ao 1 @ 0x819a~^jump
EOF
EXPECT=<<EOF
0x00008158      callp .s2 sym.c_strlen,b3
0x00008178      callp .s2 sym.decrypt,b3
0x0000819a      callp .s2 sym.uart_write_text,b3
jump: 0x00008000
EOF
RUN

# The compact callp issues with the mv that sets up the argument of c_strlen.
NAME=c6x a call runs the rest of its execute packet in a TI-built ELF
FILE=bins/tms320/emulateme_nostd.ccsv7.c674x.eabi.dbg.elf
CMDS=<<EOF
e asm.cpu=c674x
s 0x8158
aezi
ar a3=0x1234
ar a4=0
aezs 1
ar a4
ar b3
aezv PC
EOF
EXPECT=<<EOF
a4 = 0x00001234
b3 = 0x00008160
 PC: 0x00008088
EOF
RUN

# dis6x writes the layout field of a fetch-packet header with a trailing "b",
# which RzNum warns about when asm.sub.names evaluates the numbers of a line.
# The second header has a doubleword primary size, named as dis6x names it.
NAME=c6x fetch-packet header layout prints without a deprecated base suffix
FILE=malloc://64
CMDS=<<EOF
e asm.arch=tms320
e asm.cpu=c674x
e scr.color=0
e asm.sub.names=true
wx d9081020419e8c056bc6e0026ee82a8ce70214d258a37c05620310d0808000e1
wx 263da105763da1056e0c7c2074206c207c4074406c407ce074e06ce0000084ef @ 0x20
pd 1 @ 0x1c
pd 1 @ 0x3c
EOF
EXPECT=<<EOF
            0x0000001c      .fphead n, l, w, bu, br, nosat, 0b0001000
            0x0000003c      .fphead n, l, dw/ndw, w, nobr, nosat, 0b1111100
EOF
EXPECT_ERR=<<EOF
EOF
RUN
