e scr.color=0
e asm.lines=false
e asm.bytes=false
wx 58103d0232036e2c2fd64d1212fbde1f4602faa486423f025dbc6e6c2080c6ea @ 0
s 0
pd 6
wx d31ae98620a1ca2e4dac6e6ce652be016e6cefa1f78c45dcb4823c020000a0e6 @ 0
s 0
pd 10
EOF
EXPECT=<<EOF
0x00000000      add   .l1x 0x8,b15,a4
0x00000004      mvk   .s1 0x20,a6
0x00000006      nop   2
0x00000008      addk  .s2 0x16,b4
0x0000000a      ldnw  .d2 *b4,b4
0x0000000c      ||    callp .s2 0xfffffffffffef7d8,b3
0x00000000      mvk   .s2 0x58,b5                                      ; 'X'
0x00000002      cmpeq .l2 b4,b5,b0
0x00000004      [b0]  bnop .s1 0xfffffffffffffd94,0x5
0x00000008      ldw   .d2 *+b15[0x1],a4
0x0000000a      nop   4
0x0000000c      ldw   .d2 *++b15[0x12],b3
0x00000010      nop   4
0x00000012      bnop  .s2 b3,0x5
