0x00000000      cmplt .l2 0x0,b4,b0
0x00000002      ||    mvk .l1 0x0,a5
0x00000004      [!b0] bnop .s1 0x18,0x5
0x00000008      ||    [b0] mvc .s2 b4,ilc
0x0000000c      sploop 1
0x0000000e      ldw   .d1 *a4++[0x1],a3
0x00000010      nop   3
0x00000012      nop   1
0x00000014      spkernel 5,0
0x00000016      ||    add .l1 a3,a5,a5
0x00000018      bnop  .s2 b3,0x4
0x0000001a      mv    .l1 a5,a4
0x0000001c      .fphead n, l, w, bu, nobr, nosat, 0b1111001
