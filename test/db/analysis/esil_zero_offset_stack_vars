NAME=ESIL preserves zero-offset stack reads and writes (Thumb)
FILE==
ARGS=-a arm -b 16
CMDS=<<EOF
e cfg.bigendian=false
wx 84b000200090009904b07047
af
afv- *
aaef
afvs
afvxv
EOF
EXPECT=<<EOF
var int32_t var_10h @ stack - 0x10
afvR
   var_10h  0x6
afvW
   var_10h  0x4
EOF
RUN

