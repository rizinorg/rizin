NAME=cris v10 ao esil rzil
BROKEN=1
FILE=malloc://64
CMDS=<<EOF
e asm.arch=cris
e asm.cpu=v10
e asm.bits=32
wx 0f05
ao 1
wx 0522
ao 1
wx 4522
ao 1
wx 7fb6
ao 1
wx b309
ao 1
EOF
REGEXP_FILTER_OUT=esil:|rzil:
EXPECT=<<EOF
esil: ,
rzil: nop
esil: 5,r2,+=$z,Z,:=,31,$s,N,:=,31,$o,V,:=,$c,C,:=
rzil: (seq (set r2 (+ (var r2) (bv 32 0x5))) (set N (msb (var r2))) (set Z (is_zero (var r2))))
esil: 5,r2,=
rzil: (set r2 (bv 32 0x5))
esil: srp,pc,=
rzil: (jmp (var srp))
esil: r3,pc,=
rzil: (jmp (var r3))
EOF
RUN

