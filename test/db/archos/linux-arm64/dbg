NAME=dcu + read
FILE=bins/arm/elf/hello-linux-arm64
ARGS=-d
CMDS=<<EOF
dcu main
pi 8 @ pc
EOF
EXPECT=<<EOF
stp fp, lr, [sp, -0x10]!
mov fp, sp
adrp x0, sym..comment
add x0, x0, 0x790
bl sym.imp.printf
mov w0, 0
ldp fp, lr, [sp], 0x10
ret
EOF
RUN

