NAME=Read and Write in registers
FILE=bins/elf/ppc64le/dbg_basic_test
ARGS=-a ppc -d
CMDS=<<EOF
db @ sym.main+92
dc
dr r10
dr r10=0x34
dr r10
EOF
EXPECT=<<EOF
r10 = 0x00000000000000c8
r10 = 0x0000000000000034
EOF
RUN

NAME=rz-asm -a ppc.as -b 64 "std 31, -8(1)"
TOOL=rz-asm
FILE=std r31, -8(r1)
ARGS=-a ppc.as -b 64
EXPECT=<<EOF
f8ffe1fb
EOF
RUN

NAME=rz-asm -a ppc.as -b 32 -e "mr r10, r4"
TOOL=rz-asm
FILE=mr r10, r4
ARGS=-a ppc.as -b 32 -e
EXPECT=<<EOF
7c8a2378
EOF
RUN
