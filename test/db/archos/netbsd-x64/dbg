NAME=Signal handling ppc64le
FILE=bins/rizin-testbins/elf/netbsd-calculate-x64
ARGS=-d
CMDS=<<EOF
dkl~SIGTERM
dko 15 skip
dkl~SIGTERM
dko 15 reset
dkl~SIGTERM
dk 15
dc
EOF
EXPECT=<<EOF
15 SIGTERM
15 SIGTERM skip
15 SIGTERM
[+] signal 15 aka SIGTERM received 0
EOF
RUN