!sleep 0.5
dm @ rip~*~[8]
EOF
EXPECT=<<EOF
/libexec/ld-elf.so.1
EOF
RUN

NAME=dcu + read
FILE=bins/elf/hello-freebsd-x64
ARGS=-d
CMDS=<<EOF
dcu main
pi 10 @ rip
EOF
EXPECT=<<EOF
push rbp
mov rbp, rsp
sub rsp, 0x10
mov dword [rbp-0x04], 0x00
mov rdi, str.Hello_World
mov al, 0x00
call sym.imp.printf
xor eax, eax
add rsp, 0x10
pop rbp
EOF
RUN

