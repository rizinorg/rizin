NAME=rz-prologues help
TOOL=rz-prologues
ARGS=-h
EXPECT=<<EOF
[36mUsage: [0mrz-prologues (-f <file> | -d <dir>) [options]
 [32m-f[0m[33m file [0m     [0mInput binary file to process
 [32m-d[0m[33m dir [0m      [0mInput directory containing binaries to process (non-recursive)
 [32m-o[0m[33m file [0m     [0mWrite output to file instead of stdout
 [32m-j[0m           [0mOutput in JSON format (default is YAML)
 [32m-l[0m[33m len [0m      [0mPrologue length in bytes (default: 16)
 [32m-e[0m[33m threshold [0m[0mEntropy threshold for wildcard generalization [0.0-1.0] (default: 0.8)
 [32m-r[0m           [0mOutput raw prologues without entropy-based generalization
 [32m-t[0m           [0mOutput prefix tree (trie) structure instead of prologue list
 [32m-a[0m[33m arch [0m     [0mFilter / target architecture (e.g. x86, arm)
 [32m-b[0m[33m bits [0m     [0mFilter / target bitness of arch (e.g. 16, 32, 64)
 [32m-B[0m           [0mTarget big-endian architecture (default: little-endian)
 [32m-q[0m           [0mQuiet mode (suppress log messages)
 [32m-v[0m           [0mShow version information
 [32m-h[0m           [0mShow this help message

[36mNotes:[0m
  When processing a directory (-d), if architecture (-a) or bits (-b) are not
  specified, the tool adopts the architecture of the first valid binary to
  prevent mixing cross-architecture prologues.

  Generated JSON prologues (-j) can be loaded into Rizin for function analysis
  using the 'aapf <file>' command.

[36mExamples:[0m
  # Extract generalized JSON prologues from a binary
  rz-prologues -f input.bin -j -o output.json

  # Extract 64-bit x86 prologues from a directory in quiet mode
  rz-prologues -d /path/to/bins -a x86 -b 64 -jq -o x86_64.json

  # Extract raw prologues without entropy-based generalization
  rz-prologues -f input.bin -rj -o raw_prologues.json

  # Dump the prefix tree (trie) structure without generalization to YAML
  rz-prologues -f input.bin -tr -o trie.yaml
EOF
RUN

