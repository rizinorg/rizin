wv4 0xfeedface @ 0x70
s 0xe
aezi
ar a0=1
ar b5=0x70
ar b4=0x11223344
aezs
ar b4
ar a10
aezv PC
EOF
EXPECT=<<EOF
b4 = 0x11223344
a10 = 0xffffffff
 PC: 0x00000060
EOF
