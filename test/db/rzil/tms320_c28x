vstatus = 0x00001400
vashl32 vr1 << #4
-- VASHL32 negative saturates
vr1 = 0x80000000
vstatus = 0x00001400
vashl32 vr1 << #4
-- VASHL32 no overflow
vr1 = 0x01000000
vstatus = 0x00000000
vinc vr1l
-- VINC VR1L wraps
vr1 = 0x12340000
vdec vr1l
-- VDEC VR1L wraps
vr1 = 0x1234ffff
vinc vr1l || vmov32 vr2, *xar4++
-- VINC VR1L par VMOV32 VR2,XAR4++
vr1 = 0x00000006
vr2 = 0x12345678
xar4 = 0x00000042
vbitflip vr1
-- VBITFLIP VR1
vr1 = 0x1e6a2c48
vrevb vr1
-- VREVB VR1
vr1 = 0x78563412
EOF
RUN
