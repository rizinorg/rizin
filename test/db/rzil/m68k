NAME=m68k aez bsr and rts
FILE=malloc://128
ARGS=-a m68k -b 32 -E big
CMDS=<<EOF
wx 61ff00000010
ar a7=0x40
aezi
aezs
ar a7
pxw 4 @ 0x3c
ar pc
wx 4e75
s 0
ar a7=0x20
wx 00000012 @ 0x20
aezi
aezs
ar a7
ar pc
EOF
EXPECT=<<EOF
a7 = 0x0000003c
0x0000003c  0x00000006                                   ....
pc = 0x00000012
a7 = 0x00000024
pc = 0x00000012
EOF
RUN

