NAME=Testing the decryption in emulateme m68060
FILE=bins/elf/m68k/emulateme-m68060
TIMEOUT=30
REGEXP_FILTER_ERR=ERROR.*\n
CMDS=<<EOF
e io.cache=1
aaa
wx 00100000 @ 0x200080
wx 00200100 @ 0x200084
wx 416e79436f6c6f7572596f754c696b65 @ 0x200100
s sym.decrypt
aezi
aezv a7 0x200080
aezsu 0x100194
aezv d0
ps @ obj.seckrit
EOF
EXPECT=<<EOF
a7 = 0x200080
 d0: 0x00000001
Hello from RzIL!
EOF
EXPECT_ERR=
RUN

NAME=m68k aez dbra taken
FILE=malloc://128
ARGS=-a m68k -b 32 -E big
CMDS=<<EOF
wx 51c8fffc
ar d0=0x00000002
aezi
aezs
ar d0
ar pc
EOF
EXPECT=<<EOF
d0 = 0x00000001
pc = 0xfffffffe
EOF
RUN

NAME=m68k aez dbra fallthrough
