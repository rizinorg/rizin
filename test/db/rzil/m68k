NAME=Testing the decryption in emulateme m68060
FILE=bins/elf/m68k/emulateme-m68060
TIMEOUT=30
REGEXP_FILTER_ERR=ERROR.*\n
CMDS=<<EOF
e io.cache=1
aaa
wx 00100000 @ 0x200080
wx 00200100 @ 0x200084
wx 416e79436f6c6f7572596f754c696b65 @ 0x200100
s sym.decrypt
aezi
aezv a7 0x200080
aezsu 0x100194
aezv d0
ps @ obj.seckrit
EOF
EXPECT=<<EOF
a7 = 0x200080
 d0: 0x00000001
Hello from RzIL!
EOF
EXPECT_ERR=
RUN

NAME=m68k aez MOVEM predecrement uses CPU-specific base value
FILE=malloc://256
ARGS=-a m68k -b 32 -E big
CMDS=<<EOF
wx 48e08080 @ 0
wx 48e14040 @ 0x40
e asm.cpu=68020
s 0
aezi
aezv a0 0x20
aezv d0 0x11223344
aezs
ar a0
pxwj 8 @ 0x18
e asm.cpu=68000
s 0x40
aezi
aezv a1 0x60
aezv d1 0x11223344
aezs
ar a1
pxwj 8 @ 0x58
EOF
EXPECT=<<EOF
a0 = 0x20
d0 = 0x11223344
