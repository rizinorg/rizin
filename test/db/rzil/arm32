NAME=arm msr and mrs of the spsr and cpsr
FILE==
CMDS=<<EOF
e asm.arch=arm
e asm.bits=32
e cfg.bigendian=false
wx 03f06ce1 @ 0x0 # msr spsr_fs, r3
wx 00204fe1 @ 0x4 # mrs r2, spsr
wx 00f26ee1 @ 0x8 # msr spsr_fiq, r0
wx 03f02ce1 @ 0xc # msr apsr_nzcvqg, r3
wx 00200fe1 @ 0x10 # mrs r2, apsr
aoi 1 @ 0x0
aoi 1 @ 0x4
aoi 1 @ 0x8
aoi 1 @ 0xc
aoi 1 @ 0x10
EOF
EXPECT=<<EOF
0x0 (set spsr (| (& (var spsr) (bv 32 0xffff)) (& (var r3) (bv 32 0xffff0000))))
0x4 (set r2 (var spsr))
0xc (seq (set gef (cast 4 false (>> (var r3) (bv 5 0x10) false))) (set nf (! (is_zero (& (var r3) (bv 32 0x80000000))))) (set zf (! (is_zero (& (var r3) (bv 32 0x40000000))))) (set cf (! (is_zero (& (var r3) (bv 32 0x20000000))))) (set vf (! (is_zero (& (var r3) (bv 32 0x10000000))))) (set qf (! (is_zero (& (var r3) (bv 32 0x8000000))))))
0x10 (set r2 (| (ite (var nf) (bv 32 0x80000000) (bv 32 0x0)) (| (ite (var zf) (bv 32 0x40000000) (bv 32 0x0)) (| (ite (var cf) (bv 32 0x20000000) (bv 32 0x0)) (| (ite (var vf) (bv 32 0x10000000) (bv 32 0x0)) (| (ite (var qf) (bv 32 0x8000000) (bv 32 0x0)) (<< (cast 32 false (var gef)) (bv 5 0x10) false)))))))
EOF
RUN

