NAME=c2x RzIL VM: emulateme complex exerciser (loops, MAC, XOR buffer, call/stack, fold)
FILE=malloc://0x800
ARGS=-a tms320 -b 16 -e asm.cpu=c2x -e analysis.cpu=c2x
CMDS=<<EOF
e io.cache=true
wx 
aezi
aezv sp 0x100
aezsu 0x98
p8 10 @ 0x620
p8 16 @ 0x630
ar acc
ar p
ar t
ar arp
EOF
EXPECT=<<EOF
sp = 0x100
001f00ad0000003e010f
0059005b005e005b005f00530058005c
acc = 0x0000010f
p = 0x00000024
t = 0x0006
arp = 0x0004
EOF
RUN

