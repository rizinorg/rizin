NAME=emulateme nostdlib rv32imc
FILE=bins/elf/emulateme.nostd.rv32imc
TIMEOUT=30
CMDS=<<EOF
s sym.decrypt
af
o malloc://0x1000 0x40000
o malloc://0x10 0x50000
oC 0x10 @ obj.seckrit
omb. obj.seckrit @ 0x0
w AnyColourYouLike @ 0x50000
aezi
ar sp=0x41000
ar a0=0x50000
aezsu `pdf~ret[1]`
ps @ obj.seckrit
EOF
EXPECT=<<EOF
Hello from RzIL!
EOF
RUN

