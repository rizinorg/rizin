# Assembler idioms rendered like the TI reference (dis6x): MV/NEG/NOT/ZERO and
# the negative-constant SUB, plus the 40-bit (slong) SUB/ADD pair destinations.
d "zero .l1 a3" f8008001 0x0
d "zero .l1 a7:a6" f8040003 0x0
d "not .s1 a3,a3" a0e28f01 0x0
