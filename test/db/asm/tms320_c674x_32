# TMS320C674x (unified fixed + floating-point VLIW) native disassembler
# Instruction words are little-endian; addresses are the packet PCE1.
# Several vectors are cross-checked against TI dis6x (c6000 v7.4.4).
d "nop" 00000000 0x0
d "nop 5" 00800000 0x0
d "mvk .s1 0x0,a0" 28000000 0x0
d "mvk .s2 0x0,b0" 2a000000 0x0
d "mvkh .s1 0x0,a5" 68008002 0x0
d "add .l1 a0,a1,a2" 78000401 0x0
