d "mpysp .m1 a0,a1,a2" 000e0401 0x0
d "adddp .l1 a1:a0,a3:a2,a5:a4" 18030802 0x0
d "mpydp .m1 a1:a0,a3:a2,a5:a4" 00070802 0x0
d "add2 .s1 a1,a2,a3" 60208801 0x0
d "sub2 .s2 b1,b2,b3" 62248801 0x0
d "ldb .d1 *a4,a3" 24029001 0x0
d "ldbu .d1 *+a3[0x1],a3" 14228c01 0x0
d "ldw .d2 *-b1[b5],b28" e6a8041e 0x0
d "lddw .d1 *a4,a1:a0" 64031000 0x0
d "[a0] stb .d2 b0,*b4++[0x1]" b63610c0 0x0
d "[a2] ldw .d2 *+b14[0x302c],b3" 6e2cb0a1 0x0
d "[a0] mv .l2x a5,b5" db1f94c2 0x0
d "[a0] mv .l1x b5,a3" d91f94c1 0x0
d "[b1] neg .l1 a6,a6" d8001843 0x0
d "[a0] sub .l2 b4,0x1,b4" 5ae013c2 0x0
d "bnop .s2 b3,0x4" 62838c00 0x0
d "b .s1 0x20" 10040000 0x0
d "b .s2 b3" 62030c00 0x0
d ".fphead n, l, w, bu, nobr, nosat, 0001000b" 000000e1 0x1c
d ".fphead n, l, w, b, nobr, nosat, 1111010b" 082841ef 0x5c
d "[b0] bnop .s1 0x40,0x4" 21810820 0x38 (branch (! (is_zero (var b0))) (jmp (bv 32 0x40)) nop)
