# Software-pipelined loop buffer and unsigned int/float conversions, all
# cross-checked against TI dis6x (c6000 v7.4.4) and found in real C674x firmware.
d "sploop 1" 00800300 0x0
d "sploopd 1" 00a00300 0x0
d "sploopw 1" 00e00300 0x0
d "[a0] sploopw 6" 00e083c2 0x0
d "spkernel 0" 01400300 0x0
d "spkernel 40" 0140030a 0x0
d "spmask s1" 01001300 0x0
d "spmask l1,s2" 00002700 0x0
d "spmask m2" 00000302 0x0
d "intdpu .l1 a3,a5:a4" 78070c02 0x0
d "intspu .l1 a6,a4" 39091802 0x0
d "mpy .m2 0xc,b4,b4" 028c1102 0x0
d "[!a0] subah .d1 a11,0x15,a3" c0bbaed1 0x0

# .D address arithmetic with a 15-bit constant reuses the byte/halfword/word
# store slots; without the creg=0/z=1 marker these stay stores. Cross-checked
# against TI dis6x and found mis-decoded as stb/sth on real C674x firmware.
d "addab .d2 b15,17,b4" be110012 0x0
d "addah .d1x b15,127,a4" dd7f0012 0x0

# Unsigned subtract widening into a register pair: both sources stay single and
# the cross path feeds src1. Found on real C674x firmware, matched to TI dis6x.
d "subu .l2x a3,b6,b7:b6" fb771803 0x0
