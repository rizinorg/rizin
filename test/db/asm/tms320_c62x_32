d "addab .d1 a4,a5,a6" 40b81003 0x0 (set a6 (+ (var a4) (var a5)))
d "addah .d1 a4,a5,a6" 40ba1003 0x0 (set a6 (+ (var a4) (<< (var a5) (bv 32 0x1) false)))
