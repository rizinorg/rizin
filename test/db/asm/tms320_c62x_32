d "b .s1 0x20" 10040000 0x0 (jmp (bv 32 0x20))
d "b .s2 b3" 62030c00 0x0 (jmp (var b3))
d "smpy .m1 a0,a1,a2" 000d0401 0x0 (set a2 (let _p (* (cast 32 (msb (cast 16 false (var a0))) (cast 16 false (var a0))) (cast 32 (msb (cast 16 false (var a1))) (cast 16 false (var a1)))) (ite (== (var _p) (bv 32 0x40000000)) (bv 32 0x7fffffff) (<< (var _p) (bv 32 0x1) false))))
