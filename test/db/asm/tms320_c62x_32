d "mvk .s1 0x0,a0" 28000000 0x0 (set a0 (bv 32 0x0))
d "add .l1 a0,a1,a2" 78000401 0x0 (set a2 (+ (var a0) (var a1)))
d "and .l1 0x8,a3,a0" 580f0d00 0x0 (set a0 (& (bv 32 0x8) (var a3)))
