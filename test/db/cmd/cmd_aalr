NAME=aalr stripped Rust ELF64 strings, panic locations, and crates
FILE=bins/elf/rust_stripped
CMDS=<<EOF
aalr
fl~alpha_greeting
fl~beta_greeting
fl~explicit_panic
fl~rust_utf8
aalrj~src/rust_stripped.rs~?
EOF
EXPECT=<<EOF
strings: 222 (data: 132, code: 90)
panic_locations: 230 (source_files: 62, user_files: 1, crates: 4)
user_files:
  src/rust_stripped.rs
crates:
  addr2line-0.25.0
  gimli-0.32.0
  miniz_oxide-0.8.9
  rustc-demangle-0.1.26
0x00007047 18 str.alpha_greeting_str
0x00007036 17 str.beta_greeting_str
0x00007020 22 str.explicit_panic_trigger
0x000063f8 15 str.rust_utf8_caf
1
EOF
RUN

