NAME=pxB shifts 1, 3, 7 cross-byte extraction
FILE=malloc://16
CMDS=wx caf055aa ; e hex.cols=4 ; pxB 4 1 ; pxB 4 3 ; pxB 4 7
EXPECT=<<EOF
0x00000000+1 1001.0101 1110.0000 1010.1011 0101.0100  95 e0 ab 54  ...T
0x00000000+3 0101.0111 1000.0010 1010.1101 0101.0000  57 82 ad 50  W..P
0x00000000+7 0111.1000 0010.1010 1101.0101 0000.0000  78 2a d5 00  x*..
EOF
RUN

