NAME=pf elf_header times fix
FILE==
CMDS=<<EOF
e asm.arch=x86
pfo elf32
pfn elf_header
pfs elf_header
echo
wz `pfn elf_header`
(pfelf num; pfn elf_header${num} {${num}}`ps`; pfn elf_header${num}; pfs elf_header${num})
.(pfelf 1)
echo
.(pfelf 2)
EOF
EXPECT=<<EOF

EOF
RUN

