NAME=overlap0
FILE==
CMDS=<<EOF
w AAAA
/x 4141
EOF
EXPECT=<<EOF
0x00000000 2 hit.bytes.0
0x00000002 2 hit.bytes.1
EOF
RUN

NAME=overlap1
FILE==
CMDS=<<EOF
e search.overlap=true
w AAAA
/x 4141
EOF
EXPECT=<<EOF
0x00000000 2 hit.bytes.0
0x00000001 2 hit.bytes.1
0x00000002 2 hit.bytes.2
EOF
RUN
