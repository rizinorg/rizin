NAME=help
FILE=
CMDS=pg?
EXPECT=<<EOF
Usage: pg[jad]   # Core plugin to generate prologues from given set of binaries having symbol info.
| pg[j]        # Generate prologues only from current open file
| pga[j]       # Generate prologues for all open files (arch adopted from config: asm.arch/bits and cfg.bigendian)
| pgd[j] <dir> # Generate prologues for all files in a directory (arch adopted from config: asm.arch/bits and cfg.bigendian)
EOF
RUN

NAME=configs
FILE=
CMDS=<<EOF
el plugins.prologues_generator.entropy_threshold
e plugins.prologues_generator.entropy_threshold
el plugins.prologues_generator.prologue_len
e plugins.prologues_generator.prologue_len
EOF
EXPECT=<<EOF
plugins.prologues_generator.entropy_threshold: Shannon entropy threshold for node splitting: 0.0-1.0 (strictly > threshold; not inclusive).
0.8
plugins.prologues_generator.prologue_len: Number of bytes (>0) to extract from start of function for prologue generation
16
EOF
RUN

