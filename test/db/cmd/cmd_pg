NAME=help
FILE=
CMDS=pg?
EXPECT=<<EOF
Usage: pg[jad]   # Core plugin to generate prologues from given set of binaries having symbol info.
| pg[j]        # Generate prologues only from current open file
| pga[j]       # Generate prologues for all open files (arch will be adopted from first open binary)
| pgd[j] <dir> # Generate prologues for all files in a directory (arch will be adopted from first valid binary)
EOF
RUN

NAME=configs
FILE=
CMDS=<<EOF
e plugins.prologues_generator.entropy_threshold
e plugins.prologues_generator.prologue_len
EOF
EXPECT=<<EOF
0.8
16
EOF
RUN

NAME=generate prologues from current open file
