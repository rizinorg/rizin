NAME=register metadata JSON and text output
FILE==
CMDS=<<EOF
# Both command families list the same register types.
arTj
drTj
# Include roles that have no register in the active profile.
e asm.arch=x86
e asm.bits=64
arRj
# Resolve roles from an explicitly loaded profile.
arpo scripts/reg-json-profile
drpo scripts/reg-json-profile
arRj
drRj
# Each register bank keeps its own profile.
drpo scripts/reg-json-debug-profile
arRj~{[0]}
drRj~{[0]}
# Keep text output unchanged for resolved and unresolved roles.
arpo scripts/reg-json-profile
drpo scripts/reg-json-profile
arR
drR
EOF
