NAME=pf xxd=123
FILE==
CMDS=<<EOF
pfn foo "xxd foo bar cow"
pf. foo
pf. foo.foo
.pfw foo.foo 123
pf. foo.foo
pf. foo
EOF
EXPECT=<<EOF
0x00000000 : foo = 0x00000000 [LE]
0x00000004 : bar = 0x00000000 [LE]
0x00000008 : cow = 0 [LE]
0x00000000 : foo = 0x00000000 [LE]
0x00000000 : foo = 0x00000000 [LE]
0x00000000 : foo = 0x00000000 [LE]
0x00000004 : bar = 0x00000000 [LE]
0x00000008 : cow = 0 [LE]
EOF
RUN

NAME=pf xxd.cow=123
FILE==
CMDS=<<EOF
pfn foo "[2]xxd foo bar cow"
pf. foo.cow
.pfw foo.cow 123
pf. foo.cow
EOF
EXPECT=<<EOF
0x0000000c : cow = 0 [LE]
0x0000000c : cow = 0 [LE]
EOF
RUN

NAME=pf array with one write
FILE==
CMDS=<<EOF
pfn foo "[3]x foo"
.pfw foo.foo 1
pf. foo
EOF
EXPECT=<<EOF
0x00000000 : foo = [ 0x00000000, 0x00000000, 0x00000000 ] [LE]
EOF
RUN

NAME=pf array not in meta
FILE==
BROKEN=1
CMDS=<<EOF
pfn foo "[3]x foo"
.pf foo.foo 1
.pf .foo
e asm.lines=0
pd 1
EOF
EXPECT=<<EOF
0x00000000 foo : 0x00000000 = [ 0x00000001, 0x00000000, 0x00000000 ]
EOF
RUN

NAME=pf xxd print happy
FILE==
CMDS=<<EOF
e asm.arch=x86
pfn foo "xxd foo bar cow"
w hello happy world
e asm.lines=0
pf. foo
EOF
EXPECT=<<EOF
0x00000000 : foo = 0x6c6c6568 [LE]
0x00000004 : bar = 0x6168206f [LE]
0x00000008 : cow = 544829552 [LE]
EOF
RUN

NAME=pf xxd print
BROKEN=1
FILE==
CMDS=<<EOF
pfn foo "[2]xxd foo bar cow"
w hello happy world
e asm.lines=0
e asm.flags.inbytes=1
.pf* .foo
pd 3
EOF
EXPECT=<<EOF
            ;-- foo:
            0x00000000      .qword 0x6168206f6c6c6568
            ;-- bar:
            0x00000008      .dword 0x20797070
            ;-- cow:
            0x0000000c      .dword 0x6c726f77
EOF
RUN

