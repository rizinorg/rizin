            0x08000059      mov   eax, loc.internal_word               ; 0x8000067 ; "4\U00000012B\xff\xff\U00000004"; RELOC 32 .data @ 0x08000067
EOF
# The byte relocation includes the implicit addend 2 for internal_byte.
RUN

