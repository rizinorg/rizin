# Relocation patching for the C6000 EABI, checked by hand against SPRAB89
# Table 13-6. far_target resolves to 0x08000570.
#
#   0x08000040  R_C6000_PCR_S21  field [32,7,21] scaled by 4
#               (S - P) >> 2 = (0x08000570 - 0x08000040) >> 2 = 0x14c
#               word 0x00000010 -> 0x0000a610, since 0x14c << 7 = 0xa600
#   0x08000048  R_C6000_ABS_L16  field [32,7,16], low half  = 0x0570
#               word 0x00000028 -> 0x0002b828, since 0x570 << 7 = 0x2b800
#   0x0800004c  R_C6000_ABS_H16  field [32,7,16], high half = 0x0800
#               word 0x00000068 -> 0x00040068, since 0x800 << 7 = 0x40000
NAME=TMS320C6000 EABI relocation patching
FILE=bins/tms320/elf/c6x_reloc.eabi.elf
CMDS=<<EOF
e bin.relocs.apply=true
e scr.color=0
ir
s 0x08000040
p8 4
s 0x08000048
p8 8
EOF
EXPECT=<<EOF
     vaddr      paddr     target type            name          
---------------------------------------------------------------
0x08000040 0x00000040 0x08000570 R_C6000_PCR_S21 far_target
0x08000048 0x00000048 0x08000570 R_C6000_ABS_L16 far_target
0x0800004c 0x0000004c 0x08000570 R_C6000_ABS_H16 far_target
0x08000066 0x00000066 0x080001dd R_C6000_ABS32   .debug_abbrev
