NAME=ELF: AArch64 GOT load in an object resolves to the global (#7134)
FILE=bins/elf/aarch64-got-relocs.o
CMDS=<<EOF
# The page and offset of the GOT entry of shape_total, which holds its address.
pd 2 @ sym.bump
s sym.bump
aezi
aezs 2
ar x8
EOF
EXPECT=<<EOF
            ;-- section..text:
            ;-- reloc.shape_total:
            ;-- bump:
            0x08000040      adrp  x8, segment.ehdr                     ; 0x8000000; RELOC 0 shape_total ; [02] -r-x section size 116 named .text
            ;-- reloc.shape_total.8000044:
            0x08000044      ldr   x8, [x8, 0x490]                      ; RELOC 0 shape_total
x8 = 0x0000000008000400
EOF
RUN

NAME=ELF: AArch64 GOT relocations of an object get GOT entries (#7134)
FILE=bins/elf/aarch64-got-relocs.o
ARGS=-e asm.sub.names=false
CMDS=<<EOF
oml~got
# The entries of shape_total, ext_data, local_data and ext_func.
pxq 0x20 @ 0x08000490
# GCC's code: the page of the GOT from _GLOBAL_OFFSET_TABLE_, and the offset of the entry of ext_data from it.
pi 2 @ sym.load
# A literal load of the entry of local_data, the GOT, then offsets from it of the entry of ext_func.
pi 14 @ sym._start
# RzIL loads the addresses of ext_data, local_data and ext_func.
s sym.load
aezi
aezs 2
ar x0
s sym._start
aezi
aezs 18
ar x0
ar x2
ar x3
ar x4
ar x5
ar x6
ar x7
EOF
EXPECT=<<EOF
 2 fd: 5 +0x00000000 0x08000490 - 0x080004af r-- vmap.got
0x08000490  0x0000000008000400  0x0000000008000408   ................
0x080004a0  0x00000000080000b4  0x0000000008000410   ................
adrp x0, 0x8000000
ldr x0, [x0, 0x498]
ldr x2, 0x80004a0
adrp x0, 0x8000000
add x0, x0, 0x490
ldr x3, [x0, 0x18]
mov x4, 0x18
movz x5, 0, lsl 16
movk x5, 0x18
movz x6, 0, lsl 32
movk x6, 0, lsl 16
movk x6, 0x18
movz x7, 0, lsl 48
movk x7, 0, lsl 32
movk x7, 0, lsl 16
movk x7, 0x18
x0 = 0x0000000008000408
x0 = 0x0000000008000490
x2 = 0x00000000080000b4
x3 = 0x0000000008000410
x4 = 0x0000000008000410
x5 = 0x0000000008000410
x6 = 0x0000000008000410
x7 = 0x0000000008000410
EOF
RUN

