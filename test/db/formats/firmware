0x0000007c 0x10 0x10000000  0x10   0x0 -r-x core1_text_2      
0x0000008c  0x8 0x10001000   0x8   0x0 -rw- core1_data_3      
0x00000064 0x10 0x10000000  0x10   0x0 -r-x core0_text_0      
0x00000074  0x8 0x10001000   0x8   0x0 -rw- core0_data_1      
