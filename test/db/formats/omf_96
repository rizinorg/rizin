CMDS=<<EOF
iI~bits
echo ---
iH
echo ---
ie:quiet
echo ---
is
echo ---
iS
echo ---
oml
echo ---
px 16 @ section.text_1
px 16 @ section.data_1
e asm.bytes=true
pdq 1~mov[1]
