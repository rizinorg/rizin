      seg_idx: 1
      offset: 0x0
      segment: "text"
      paddr: 0x0
      vaddr: 0x10010
      type_index: 0
      visibility: "public"
      type: "OMF_PUBDEF - Public Names Definition Record 16 bits"

---
0x00000010 0x00000000 ---------- ---------- program
---
nth      paddr      vaddr bind   type size lib name   
------------------------------------------------------
  0 0x00000000 0x00010010 GLOBAL NONE    0     _start
---
