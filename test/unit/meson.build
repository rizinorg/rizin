    'uleb128': [rz_io_dep],
    'unicode': [],
    'unum': [rz_il_dep, mth],
    'util': [],
    'vector': [],
    'yank': [rz_config_dep, rz_core_dep],
  }

  if not use_system_capstone
    tests += {
      'analysis_op': [rz_arch_dep, rz_config_dep, rz_core_dep, rz_flag_dep, rz_io_dep],
      'analysis_m68k': [rz_arch_dep, rz_config_dep, rz_core_dep, rz_il_dep, rz_io_dep, rz_reg_dep],
    }
  endif

  unit_test_env = environment()
  if test_env_common_path != []
    unit_test_env.prepend('PATH', test_env_common_path)
  endif

  foreach test, test_deps : tests
    exe = executable('test_@0@'.format(test), 'test_@0@.c'.format(test),
      include_directories: [platform_inc, '.'],
      dependencies: [
        rz_util_dep,
        lrt,
      ] + test_deps,
      install: false,
      install_rpath: rpath_exe,
      implicit_include_directories: false,
    )
    test(test, exe, workdir: join_paths(meson.current_source_dir(), '..'), env: unit_test_env, depends: [auxiliaries, types_files], suite: 'unit')
  endforeach
endif
