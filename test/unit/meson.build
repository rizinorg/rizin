    'core_task': [rz_config_dep, rz_cons_dep, rz_core_dep],
    'crypto': [rz_crypto_dep],
    'debruijn': [],
    'debug': [rz_cons_dep, rz_debug_dep, rz_io_dep, rz_reg_dep],
    'debug_session': [rz_debug_dep, rz_reg_dep],
    'diff': [rz_diff_dep],
    'ebcdic': [rz_io_dep],
    'endian': [rz_io_dep],
