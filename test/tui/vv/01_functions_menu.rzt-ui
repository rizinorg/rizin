# `Vv` enters the visual function/variable analysis browser.
NAME=Vv opens the functions browser
FILE=malloc://128
ARGS=-a x86 -b 64 -c "wx 554889e5897dfc8b07c3"
COLS=80
ROWS=24
STEPS=<<STEPEOF
KEYS Vv<ENTER>
WAIT 400
EXPECT_LINE 0 -[ functions ]
EXPECT_LINE 0 pdf
EXPECT_AT 23 72 100.0%
QUIT
STEPEOF
