# `l` moves the bit cursor right; the bit index and shift update accordingly.
NAME=bit editor moves the bit cursor
FILE=malloc://128
ARGS=-a x86 -b 64 -c "wx 554889e5897dfc8b07c3"
COLS=80
ROWS=24
STEPS=<<STEPEOF
KEYS V<ENTER>
WAIT 300
KEY b
WAIT 250
KEY 1
WAIT 300
KEY l
WAIT 250
EXPECT_LINE 7 bit 1 [1]
EXPECT_LINE 13 shift: >> 1 << 6
QUIT
STEPEOF
