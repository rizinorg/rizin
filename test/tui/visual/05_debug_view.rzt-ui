# `pp` switches to the debug / emulator print mode with the register panel.
NAME=pp shows the debug register view
FILE=malloc://128
ARGS=-a x86 -b 64 -c "wx 554889e5897dfc8b07c3"
COLS=80
ROWS=24
STEPS=<<STEPEOF
KEYS V<ENTER>
WAIT 300
KEYS pp
WAIT 300
EXPECT_LINE 0 [xaDvc]
EXPECT_LINE 1 dead at 0x00000000
EXPECT_REGEX rax 0x0000000000000000
EXPECT_REGEX rflags 0x0000000000000000
QUIT
STEPEOF
