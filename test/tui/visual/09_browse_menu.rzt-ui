# `b` opens the browse menu listing the available browsers.
NAME=b opens the browse menu
FILE=malloc://128
ARGS=-a x86 -b 64 -c "wx 554889e5897dfc8b07c3"
COLS=80
ROWS=24
STEPS=<<STEPEOF
KEYS V<ENTER>
WAIT 300
KEY b
WAIT 300
EXPECT_REGEX bit editor \(vd1\)
EXPECT_REGEX blocks
EXPECT_REGEX functions
EXPECT_REGEX imports
QUIT
STEPEOF
