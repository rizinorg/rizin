# `c` toggles cursor mode: the title gains the cursor address and a `|` grid.
NAME=c toggles cursor mode
FILE=malloc://128
ARGS=-a x86 -b 64 -c "wx 554889e5897dfc8b07c3"
COLS=80
ROWS=24
STEPS=<<STEPEOF
KEYS V<ENTER>
WAIT 300
KEY c
WAIT 200
EXPECT_LINE 0 *0x00000000
EXPECT_LINE 0 ($$+0x0)
EXPECT_REGEX 0x00000000 \|5548
EXPECT_CELL 1 11 |
EXPECT_CELL 2 51 |
EXPECT_VLINE 11 1 23 |
EXPECT_VLINE 51 1 23 |
QUIT
STEPEOF
