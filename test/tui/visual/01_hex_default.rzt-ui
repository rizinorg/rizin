# Entering visual mode with `V` lands in the hexdump view.
NAME=main visual opens in hexdump view
FILE=malloc://128
ARGS=-a x86 -b 64 -c "wx 554889e5897dfc8b07c3"
COLS=80
ROWS=24
STEPS=<<STEPEOF
KEYS V<ENTER>
WAIT 300
EXPECT_LINE 0 [0x00000000
EXPECT_LINE 0 [Xadvc]
EXPECT_LINE 0 malloc://128
EXPECT_LINE 1 - offset -
EXPECT_LINE 1 0123456789ABCDEF
EXPECT_LINE 2 5548 89e5 897d fc8b 07c3
EXPECT_LINE 2 UH...}
QUIT
STEPEOF
