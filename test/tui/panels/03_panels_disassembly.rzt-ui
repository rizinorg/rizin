# The default layout shows a Disassembly panel and a Functions panel.
NAME=panels show disassembly and functions
FILE=malloc://128
ARGS=-a x86 -b 64 -c "wx 554889e5897dfc8b07c3"
COLS=120
ROWS=24
STEPS=<<STEPEOF
KEYS v<ENTER>
WAIT 500
EXPECT_REGEX \[X\] Disassembly \(pd 20\)
EXPECT_REGEX \[Cache\] Off
EXPECT_REGEX push  rbp
EXPECT_REGEX Functions \(afl\)
QUIT
STEPEOF
