if get_option('enable_tests') and cli_enabled
  test_conf_data = configuration_data()
  test_conf_data.set_quoted('RIZIN_BUILD_PATH', rizin_exe.full_path())
  test_conf_data.set_quoted('TEST_BUILD_TYPES_DIR', fs.as_posix(types_build_dir))
  test_config_h = configure_file(
    input: 'test_config.h.in',
    output: 'test_config.h',
    configuration: test_conf_data,
  )

  # Map each integration test to its extra dependencies beyond rz_util_dep and lrt.
  tests = {
    'analysis_fcn': [rz_arch_dep, rz_config_dep, rz_core_dep],
    'analysis_global_var': [rz_arch_dep, rz_core_dep, rz_flag_dep, rz_type_dep],
    'analysis_graph': [rz_arch_dep, rz_core_dep],
    'analysis_il': [rz_arch_dep, rz_config_dep, rz_core_dep, rz_il_dep, rz_io_dep, rz_reg_dep],
    'autocmplt': [rz_arch_dep, rz_cons_dep, rz_core_dep, rz_flag_dep, rz_type_dep],
    'basefind': [rz_core_dep, rz_io_dep],
    'bin': [rz_bin_dep, rz_io_dep],
    'bin_symbols': [rz_bin_dep, rz_io_dep],
    'bin_vfiles': [rz_bin_dep],
    'cpu_platform_profiles': [rz_arch_dep, rz_core_dep, rz_flag_dep],
    'dwarf': [rz_bin_dep, rz_core_dep, rz_io_dep],
    'dwarf_info': [rz_bin_dep, rz_io_dep],
    'dwarf_integration': [rz_arch_dep, rz_bin_dep, rz_core_dep, rz_type_dep],
    'glibc_version': [rz_core_dep, rzheap_dep],
    'interrupt_signal': [],
    'open_analyse_save_load_project': [rz_arch_dep, rz_config_dep, rz_core_dep],
    'pdb': [rz_arch_dep, rz_bin_dep, rz_core_dep, rz_type_dep],
    'project_migrate': [rz_arch_dep, rz_config_dep, rz_core_dep, rz_type_dep],
    'rzpipe': [rz_socket_dep],
    'stabs': [rz_bin_dep, rz_io_dep, rz_type_dep],
    'str_search': [rz_core_dep, rz_search_dep],
  }

  unit_test_env = environment()
  if test_env_common_path != []
    unit_test_env.prepend('PATH', test_env_common_path)
  endif

  foreach test, test_deps : tests
    exe = executable('test_@0@'.format(test), 'test_@0@.c'.format(test),
      # '.' to find autogenerated "test_config.h"
      include_directories: [platform_inc, '.'],
      dependencies: [
        rz_util_dep,
        lrt,
      ] + test_deps,
      install: false,
      install_rpath: rpath_exe,
      implicit_include_directories: false,
    )
    test(test, exe, workdir: join_paths(meson.current_source_dir(), '..'), env: unit_test_env, suite: 'integration')
  endforeach
endif
